# Variables de l’app SvelteKit — à copier en `.env`.
#
# Ce fichier sert deux choses :
#   1. `npm run dev` / `npm run build` (vite lit `.env`, `process.env` côté serveur) ;
#   2. `docker compose` (interpolation des `${...}` de `docker-compose.yml` + variables
#      injectées dans le conteneur via l’option `env_file`).
#
# Les défauts ci-dessous sont ceux de la prévisualisation locale : le stack démarre
# sans rien renseigner. Les valeurs marquées **(prod)** doivent être changées en
# production. Liste complète et rôle de chaque variable : `docs/deploiement.html`.

# --- Base SQLite (fichier) -------------------------------------------------------
# Chemin relatif au projet ou absolu. WAL activé, migrations Drizzle appliquées à
# la première ouverture de la base : une base neuve se structure toute seule.
CCN_DB_PATH=data/ccn.sqlite
# Dossier des migrations Drizzle (générées par `npm run db:generate`).
CCN_MIGRATIONS_FOLDER=drizzle

# --- Site (équivalent des méta SPIP et des constantes du plugin) -----------------
CCN_NOM_SITE=ccn.laclasse.com
CCN_PROJET=laclasse
# Année scolaire de référence (celle que choisit `ccn_options.php` hors cookie) :
# la règle calendaire du plugin (septembre → année courante) garde la main.
CCN_ANNEE_SCOLAIRE=2025
# URL publique du site, utilisée dans les liens des e-mails **(prod)**.
CCN_SITE_URL=http://192.168.100.50:8890

# --- Serveur (adapter-node) ------------------------------------------------------
HOST=0.0.0.0
PORT=3000
# Port publié par docker compose sur l’hôte (prévisualisation LAN).
CCN_PUBLISHED_PORT=8890

# --- Sessions --------------------------------------------------------------------
# Clé de signature HMAC-SHA256 du cookie `ccn_session`. **Absente = clé éphémère** :
# toutes les sessions tombent au redémarrage (acceptable en démo, pas en prod).
# Générer : `node -p "require('crypto').randomBytes(32).toString('hex')"` **(prod)**.
#CCN_SECRET=
# Origines autorisées pour les POST de formulaire (contrôle `Origin` de SvelteKit 3
# en production). Derrière un reverse proxy qui porte `x-forwarded-host`, le contrôle
# se fait seul ; en HTTP direct (prévisualisation LAN) il faut déclarer l’origine,
# sinon les formulaires sont rejetés en 403. Exemple :
#CCN_TRUSTED_ORIGINS=http://192.168.100.50:8890,http://localhost:8890

# --- Documents -------------------------------------------------------------------
# Racine des documents (parité de l’arborescence `IMG/` de SPIP).
CCN_MEDIA_RACINE=data/media
# `convert` d’ImageMagick pour les vignettes (absent = vignettes non générées,
# l’affichage des documents reste fonctionnel).
#CCN_IMAGEMAGICK=

# --- E-mails ---------------------------------------------------------------------
# `mock` (défaut) : rien n’est envoyé, chaque message est écrit dans
# `data/outbox/*.eml` et journalisé dans `data/notifications.log`.
# `smtp` : envoi réel via les CCN_SMTP_* ci-dessous. `aucun` : pipeline journalisé, pas d’envoi.
CCN_MAIL_TRANSPORT=mock
CCN_MAIL_FROM=ccn@ccn.laclasse.com
# Coupe tous les envois (parité de `config/mes_options.php` de SPIP).
CCN_NOTIFICATIONS=1
# Dossier des .eml du transport mock (relatif à la base).
CCN_OUTBOX_DIR=data/outbox
CCN_SMTP_HOST=
CCN_SMTP_PORT=587
CCN_SMTP_USER=
CCN_SMTP_PASS=
CCN_SMTP_SSL=false

# --- Tâches de fond --------------------------------------------------------------
# Mois de la « rentrée » (parité `_ANNEE_SCOLAIRE`, septembre par défaut).
CCN_RENTREE_MOIS=9
# Couleur de la carte d’e-mail (parité du modificateur `couleur_classe`).
CCN_EMAIL_COULEUR=#f86f1d

# --- Outils ----------------------------------------------------------------------
# Base interrogée par `npm run verif:json` (captures de `../baseline/json`).
CCN_BASE=http://192.168.100.50:5174
# Dépôt SPIP source (lecture seule) — utilisé par le port des CSS (`scripts/port-css.mjs`).
#CCN_SPIP_SRC=
# Trace du port des CSS (`scripts/port-css.mjs`).
#CCN_PORT_CSS_TRACE=
