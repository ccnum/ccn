# ============================================================================
# EXEMPLE DE VARIABLES D'ENVIRONNEMENT — A REMPLACER
# ============================================================================
# Copier ce fichier en .env et remplacer toutes les valeurs par les vôtres.
# Ne jamais commiter un .env contenant des credentials reels.
# En production, ces variables sont passees via docker-compose.yml ou le
# gestionnaire de secrets du cluster (Kubernetes, etc.).
# ============================================================================

SPIP_AUTO_INSTALL=1
SPIP_DB_SERVER=mysql
SPIP_DB_LOGIN=spip
SPIP_DB_PASS=ChangeMeSpipDbPassword!
SPIP_DB_NAME=spip
SPIP_SITE_ADDRESS=http://localhost:8880
SPIP_ADMIN_EMAIL=admin@example.com
SPIP_ADMIN_PASS=ChangeMeAdminPassword!
SPIP_VERSION_SITE=thematique
SPIP_PLUGINS_CIOIDC=false
SPIP_CIOIDC_CLIENT_NOM=
SPIP_CIOIDC_CLIENT_SECRET=
# true pour la page d'import de comptes par CSV (sites sans SSO ENT)
SPIP_PLUGINS_IMPORTS_UTILISATEURS=false
PROJET=laclasse
APACHE_PORT=80
VIMEO_ACCESS_TOKEN=CHANGE_ME_VIMEO_TOKEN
# Envoi des e-mails en SMTP (plugin facteur). Une variable vide laisse le
# réglage correspondant tel qu'il a été saisi dans /ecrire.
SPIP_FACTEUR_SMTP_HOST=
SPIP_FACTEUR_SMTP_PORT=
# non, tls ou ssl
SPIP_FACTEUR_SMTP_SECURE=
SPIP_FACTEUR_SMTP_USERNAME=
SPIP_FACTEUR_SMTP_PASSWORD=
SPIP_FACTEUR_FROM_EMAIL=
SPIP_FACTEUR_FROM_NOM=
# false si ce projet CCN ne repart pas d'une année sur l'autre : désactive
# la création automatique de la structure de rentrée (rubrique de l'année,
# articles jalons "Cap sur l'année"/"La Rencontre")
CCN_PROJET_ACTIVE=true
